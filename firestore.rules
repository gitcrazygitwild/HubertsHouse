rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && exists(/databases/$(database)/documents/households/home/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/households/home/members/$(request.auth.uid)).data.active == true;
    }
    match /households/home/members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /events/{id} {
      allow read, delete: if member();
      allow create, update: if member() && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 500
        && request.resource.data.start is string && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 200
        && (!('withFrankie' in request.resource.data) || (request.resource.data.withFrankie is bool && (!request.resource.data.withFrankie || request.resource.data.owner in ['hanry','karena','both'])));
    }
    match /householdItems/{id} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind','title','owner','due','cadence','list','category','quantity','completed','version','createdAt','updatedAt','lastCompletedAt','anchorDay','withFrankie'])
          && d.kind in ['chore','task','grocery'] && d.title is string && d.title.size() > 0 && d.title.size() <= 180
          && d.owner in ['hanry','karena','both'] && d.completed is bool && d.version is int
          && (!('withFrankie' in d) || d.withFrankie is bool)
          && d.cadence in ['none','daily','weekly','monthly'] && d.due is string && d.due.size() <= 10
          && d.list is string && d.list.size() <= 80 && d.quantity is string && d.quantity.size() <= 60
          && d.category in ['Produce','Dairy & eggs','Bakery','Meat & fish','Pantry','Frozen','Household','Other'];
      }
      allow read, delete: if member();
      allow create: if member() && valid() && request.resource.data.version == 0;
      allow update: if member() && valid() && request.resource.data.version == resource.data.version + 1;
    }
    // Meals: saved favorites and this week's dinner plan (Life → Meals).
    match /householdMeals/{id} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','ingredients','favorite','plannedFor','lastMade','steps','minutes','version','createdAt','updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.ingredients is list && d.ingredients.size() <= 25
          && d.favorite is bool && d.version is int
          && d.plannedFor is string && d.plannedFor.size() <= 10
          && d.lastMade is string && d.lastMade.size() <= 10
          && (!('steps' in d) || (d.steps is list && d.steps.size() <= 20))
          && (!('minutes' in d) || (d.minutes is int && d.minutes >= 0 && d.minutes <= 600));
      }
      allow read, delete: if member();
      allow create: if member() && valid() && request.resource.data.version == 0;
      allow update: if member() && valid() && request.resource.data.version == resource.data.version + 1;
    }
    // Nap prediction scoreboard: Huckleberry's SweetSpot per daytime wake-up.
    // Hubert's and Mia's guesses are recomputed from sleep history, never stored.
    // A newer capture may replace an older one (latest prediction while awake).
    match /babyPredictions/{id} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['lastWake','childId','sweetspot','createdAt','updatedAt'])
          && d.lastWake is string && d.lastWake.size() <= 40 && d.childId is string && d.childId.size() <= 150
          && d.sweetspot is map && d.sweetspot.keys().hasOnly(['target','loggedAt'])
          && d.sweetspot.target is string && d.sweetspot.target.size() <= 40 && d.sweetspot.loggedAt is string && d.sweetspot.loggedAt.size() <= 40;
      }
      allow read: if member();
      allow create: if member() && valid() && id.matches('^w[0-9]{10,14}$');
      allow update: if member() && valid() && request.resource.data.lastWake == resource.data.lastWake
        && request.resource.data.childId == resource.data.childId
        && request.resource.data.sweetspot.loggedAt > resource.data.sweetspot.loggedAt;
      allow delete: if false;
    }
    // Siri Shortcut keys (stored as SHA-256 hashes) are server-only.
    match /siriKeys/{hash} { allow read, write: if false; }
    // Newsletter preferences, the encrypted sending account and the send log are server-only.
    match /newsletterPrefs/{uid} { allow read, write: if false; }
    match /privateNewsletterSender/{doc} { allow read, write: if false; }
    match /newsletterLog/{id} { allow read, write: if false; }
    // Calendar passwords are encrypted by the server and never readable by a client.
    match /privateCalendarConnections/{uid} { allow read, write: if false; }
    match /privateCalendarAssignments/{id} { allow read, write: if false; }
    match /privateHuckleberryConnections/{uid} { allow read, write: if false; }
    match /privateBabySnapshots/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
