rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && exists(/databases/$(database)/documents/households/home/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/households/home/members/$(request.auth.uid)).data.active == true;
    }
    match /households/home/members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /events/{id} {
      allow read, delete: if member();
      allow create, update: if member() && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 500
        && request.resource.data.start is string && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 200
        && (!('withFrankie' in request.resource.data) || (request.resource.data.withFrankie is bool && (!request.resource.data.withFrankie || request.resource.data.owner in ['hanry','karena','both'])));
    }
    match /householdItems/{id} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind','title','owner','due','cadence','list','category','quantity','completed','version','createdAt','updatedAt','lastCompletedAt','anchorDay','withFrankie'])
          && d.kind in ['chore','task','grocery'] && d.title is string && d.title.size() > 0 && d.title.size() <= 180
          && d.owner in ['hanry','karena','both'] && d.completed is bool && d.version is int
          && (!('withFrankie' in d) || d.withFrankie is bool)
          && d.cadence in ['none','daily','weekly','monthly'] && d.due is string && d.due.size() <= 10
          && d.list is string && d.list.size() <= 80 && d.quantity is string && d.quantity.size() <= 60
          && d.category in ['Produce','Dairy & eggs','Bakery','Meat & fish','Pantry','Frozen','Household','Other'];
      }
      allow read, delete: if member();
      allow create: if member() && valid() && request.resource.data.version == 0;
      allow update: if member() && valid() && request.resource.data.version == resource.data.version + 1;
    }
    // Calendar passwords are encrypted by the server and never readable by a client.
    match /privateCalendarConnections/{uid} { allow read, write: if false; }
    match /privateHuckleberryConnections/{uid} { allow read, write: if false; }
    match /privateBabySnapshots/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
